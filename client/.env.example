# ──────────────────────────────────────────────────────────────
#  CLIENT (frontend) environment variables
#  Copy this file to `.env` and fill in real values.
#  Vite exposes any var prefixed with VITE_ to the client via
#  import.meta.env.VITE_*. API calls use relative /api paths resolved
#  by the Vite dev proxy (see vite.config.js) in development, and by
#  the Express static/SPA server in production. Firebase config is
#  read from VITE_FIREBASE_* below (src/firebase/firebaseConfig.js);
#  a built-in fallback is used when these are unset, so the app runs
#  out of the box — set your own for production.
# ──────────────────────────────────────────────────────────────

# Firebase web config — read by src/firebase/firebaseConfig.js.
# Optional in dev (a fallback config is used if unset); set your own
# project's values for production.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx