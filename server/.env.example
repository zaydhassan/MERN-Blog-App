# ──────────────────────────────────────────────────────────────
#  SERVER (backend) environment variables
#  Copy this file to `.env` and fill in real values.
#  Source of truth: derived from actual `process.env.*` references
#  in server/server.js and server/config/db.js.
# ──────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
DEV_MODE=development
PORT=8080

# MongoDB connection string (referenced as process.env.MONGO_URL in config/db.js)
MONGO_URL=mongodb://127.0.0.1:27017/blog-app

# Nodemailer (Gmail) — used for contact form + newsletter
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_gmail_app_password

# ── JSON Web Token auth (used in server/utils/tokenUtils.js) ──
# Access-token signing secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_hex_string
# Separate secret for refresh tokens. REQUIRED in production (must differ from
# JWT_SECRET — otherwise a long-lived refresh cookie would also validate as a
# 15-minute access token, collapsing the access lifetime to 7 days). In dev it
# optionally falls back to JWT_SECRET if unset.
JWT_REFRESH_SECRET=replace_with_another_long_random_hex_string
# Access token lifetime
JWT_EXPIRES_IN=15m
# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins (client URLs). REQUIRED in
# production (the server fails to boot with a localhost default in prod).
CLIENT_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ── Object storage for uploads (optional but recommended in prod) ──
# When set, uploads stream straight to Cloudinary (durable across redeploys);
# without it, files are written to local disk under UPLOAD_DIR (fine for dev,
# ephemeral on PaaS — Render/Railway containers lose local files on redeploy).
# Get a URL from Cloudinary: dashboard → copy your cloudinary:// URL.
# Requires the `cloudinary` and `multer-storage-cloudinary` packages
# (already in package.json).
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Scheduled-publish scheduler ──
# Single-instance dev: leave unset (the sweep runs every 60s on this server).
# Multi-instance prod: set RUN_SCHEDULER=true on ONE instance and
# RUN_SCHEDULER=false on all others, so only one server promotes due posts
# (avoids redundant DB sweeps across instances).
# RUN_SCHEDULER=true

# Optional: Redis for caching/rate-limiting (recommended)
# REDIS_URL=redis://127.0.0.1:6379

# ── Google (Firebase) OAuth ─────────────────────────────────────
# Used by server/config/firebaseAdmin.js to verify the Firebase ID tokens the
# client obtains via signInWithPopup. Get the JSON from the Firebase console:
# Project settings → Service accounts → Generate new private key, then paste
# it here as a SINGLE LINE (escape nothing — just remove the line breaks).
# Alternatively, set GOOGLE_APPLICATION_CREDENTIALS to the JSON file path.
# If unset, the /api/v1/user/google endpoint returns 503 and email/password
# auth keeps working. Also enable the Google sign-in provider in the Firebase
# console (Authentication → Sign-in method) and add localhost:3000 + your
# production domain to Authorized domains.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json